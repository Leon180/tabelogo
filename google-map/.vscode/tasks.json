{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "berforeInitServer",
            "type": "shell",
            "command": "go mod tidy;go get;wire gen ./inject/...;swag init --parseDependency --parseInternal"
        },
        {
            "label": "Generate Proto",
            "type": "shell",
            "command": "protoc",
            "args": [
                "--go_out=.",
                "--go_opt=paths=source_relative",
                "--go-grpc_out=.",
                "--go-grpc_opt=paths=source_relative,require_unimplemented_servers=false",
                "grpc/proto/*.proto"
            ]
        }
    ]
}